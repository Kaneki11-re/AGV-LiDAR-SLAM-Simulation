<?xml version="1.0"?>
<robot name="agv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ PARAMETERS ============ -->
  <xacro:property name="chassis_x" value="0.40"/>
  <xacro:property name="chassis_y" value="0.30"/>
  <xacro:property name="chassis_z" value="0.15"/>
  <xacro:property name="chassis_mass" value="8.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_separation" value="0.35"/>
  <xacro:property name="wheel_x_offset" value="0.0"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.2"/>
  <xacro:property name="caster_x_offset" value="0.15"/>

  <xacro:property name="laser_radius" value="0.04"/>
  <xacro:property name="laser_height" value="0.04"/>
  <xacro:property name="laser_mass" value="0.15"/>

  <xacro:property name="ground_clearance" value="0.02"/>
  <!-- chassis sits so its bottom is ground_clearance above ground, wheel radius must match -->

  <!-- ============ MATERIALS ============ -->
  <material name="chassis_grey"><color rgba="0.35 0.35 0.4 1.0"/></material>
  <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="caster_grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="laser_red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ============ BASE_FOOTPRINT (ground projection, standard for nav2) ============ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============ CHASSIS ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z/2}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.075" ixy="0.0" ixz="0.0" iyy="0.1217" iyz="0.0" izz="0.1667"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ============ WHEEL MACRO ============ -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.00035" ixy="0.0" ixz="0.0" iyy="0.000625" iyz="0.0" izz="0.00035"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${reflect * wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ============ CASTER (passive support wheel, front) ============ -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x_offset} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <material>Gazebo/Grey</material>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- ============ LIDAR MOUNT + LINK ============ -->
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
      <material name="laser_red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${laser_mass}"/>
      <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00008" iyz="0.0" izz="0.00012"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 ${chassis_z + laser_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- ============ GAZEBO (Harmonic / gz-sim) PLUGINS ============ -->

  <!-- Differential drive system: consumes /cmd_vel, produces wheel motion,
       publishes odometry + odom->base_footprint TF on gz transport topics -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint state publisher system: needed for wheel joints to animate + for
       robot_state_publisher to build correct wheel TFs -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR sensor (gpu_lidar) -->
  <gazebo reference="laser_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
